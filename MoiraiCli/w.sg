@1 per 5 years
event char_prestige_update items {
    each $p: (type = Person, alive, prestige > 0){
        match $p.job {
            Job.Painter => {
                if $p.prestige > 5 and $p.mastery < Mastery.Master {
                    record('{$p.name} is now a master painter')
                    set $p.mastery = Mastery.Master
                }
            }
            Job.Smith => {
                if $p.prestige > 5 and $p.mastery < Mastery.Master {
                    record('{$p.name} is now a master smith')
                    set $p.mastery = Mastery.Master
                }
            }
        }
    }
}
@1 per 1 years
event char_joins_faith {
    pick $x: (type = Person, alive, god = null)
    pick $g: (type = God)
    set $x.god = $g
    record('{$x.name} takes the faith of {$g.name}')
}
@1 per 2 years
event wedding {
    pick $x: (type = Person, alive = true, partner = null, age > Age.Child)
    pick $y: (type = Person, alive = true, partner = null, age > Age.Child, id != $x, place = $x.place)
    set $x.partner = $y
    set $y.partner = $x
    // create $i: ( Item, "Wedding ring of {$x.name}")    // set $i.owner = $x
    // create $j: ( Item, "Wedding ring of {$y.name}")    // set $j.owner = $y
    record('{$x.name} and {$y.name} get married')
}
@1 per 15 year
event divorce {
    pick $x: (type = Person, alive = true, partner != null)
    pick $y: (type = Person, alive = true, partner != null, id != $x)
    set $x.partner = null
    set $y.partner = null
    record('{$x.name} and {$y.name} separate')
}
@1 per 15 year
event murder {
    pick $x: (type = Person, alive = true, age > Age.Child)
    pick $y: (type = Person, alive = true, id != $x)
    set $y.alive = false
    record('{$x} {$x.name} murders {$y} {$y.name}')
}
@1 per 4 year
event char_migrates country {
    pick $p: (type = Person, alive, partner = null)
    pick $c: (type = Country, id != $p.place)
    set $p.place = $c
    record('{$p.name} moves to {$c.name}')
}
@1 per 4 year
event country_war_start war {
    pick $x: (type = Country, war_with = null)
    pick $y: (type = Country, id != $x, war_with = null)
    set $x.war_with = $y
    set $y.war_with = $x
    record('{$x.name} and {$y.name} start a war')
    set $x.prosperity = $x.prosperity - 1
    set $y.prosperity = $y.prosperity - 1
}
@5 per 1 year
event soldier_war_distinction war country {
    each $c: (type = Country, war_with != null){
        pick $s: (type = Person, alive, job = Job.Soldier, place = $c)
        var $o: $c.war_with
        random_weighted 100 {
            10 => {
                set $s.prestige = $s.prestige + 1
                record('{$s.name}, a soldier from {$c.name}, shines during the war with {$o.name}')
            }
            10 => {
                set $s.alive = false

                record('{$s.name}, a soldier from {$c.name}, dies during the war with {$o.name}')
            }
        }

    }
}

