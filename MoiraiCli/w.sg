entity Person {}
entity Item {}
entity Faction {}
entity Link {}

enum Job { Smith, Farmer, Painter, Sculptor }
enum Age { Child, Young, Adult, Old }
enum ItemType { Forged, Painted, Sculpted }

prop age: Age
prop first_name: string
prop alive: bool
prop birthdate: number
prop partner: ref
prop faction: ref
prop job: Job
prop item_type: ItemType

prop parent: ref
prop child: ref

prop owner: ref
 
@start
rule create_time {
    create Time, 'time'
    set year = 764
}

event inherit {
    when $p: type = Person, alive = false
    record '## {$p} {$p.name} died, inheriting'
    each $i: type = Item, owner = $p {
        record '##   {$i} {$i.name} item'
        pick $l: type = Link, $l.parent = $p
        set $i.owner = $l.child
        record '{$l.child} inherits the {$i.name} from {$p.name} - {$l}'
    }
}

// @1 per 2 year
rule char_born {
    var $fname = '{random name}'
    create $p: Person, '{$fname} {random name}'
    set $p.first_name = $fname
    set $p.alive = true
    set $p.age = Age.Child
    set $p.birthdate = #Time.year
    record '{$p.name} is born in {#Time.year}'
}
rule char_dies {
    pick $p: type = Person, alive = true
    set $p.alive = false 
    record '{$p.name} dies'
}

@1 every 1 year
rule children_grow {
    each $p: type=Person, alive = true, age = Age.Child, (birthdate + 20) <= #Time.year{
        set $p.age = Age.Young
        set $p.job = random Job
        record '{$p.name} becomes a {$p.job}'
    }
}

@1 every 1 year
rule youngs_grow {
    each $p: type=Person, alive = true, age = Age.Young, (birthdate + 40) <= #Time.year{
        set $p.age = Age.Adult
       // record '{$p.name} grew up as a {$p.age}'
    }
}

@1 every 1 year
rule adults_grow {
    each $p: type=Person, alive = true, age = Age.Adult, (birthdate + 60) <= #Time.year{
        set $p.age = Age.Old
        //record '{$p.name} grew up as a {$p.age}'
    }
}

@1 every 1 year
rule olds_dies {
    each $p: type=Person, alive = true, age = Age.Old, (birthdate + 80) <= #Time.year{
        set $p.alive = false
        record '{$p.name} dies of old age at {#Time.year - $p.birthdate} in {#Time.year}'
    }
}

rule _parent_dies {
    each $l: type = Link {
        pick $p: id = $l.parent, alive = true
        pick $c: id = $l.child
        set $p.alive = false 
        record '{$p.name}, parent of {$c.name}, dies'

    }
}
//  @1 per 2 years
rule wedding {
    pick $x: type = Person, alive = true, partner = null, age > Age.Child
    pick $y: type = Person, alive = true, partner = null, age > Age.Child, id != $x
    set $x.partner = $y
    set $y.partner = $x
    create $i: Item, "ring of {$x.name}"
    //set $i.owner = $x
    //create $j: Item, "ring of {$y.name}"
    //set $j.owner = $y
    record '{$x.name} and {$y.name} get married'
}
//  @1 per 15 year
rule divorce {
    pick $x: type = Person, alive = true, partner != null
    pick $y: type = Person, alive = true, partner != null, id != $x
    set $x.partner = null
    set $y.partner = null
    record '{$x.name} and {$y.name} separate'
} 
// @1 per 15 year
// rule murder {
//     pick $x: type = Person, alive = true
//     pick $y: type = Person, alive = true, id != $x
//     set $y.alive = false
//     record '{$x} {$x.name} murders {$y} {$y.name}'
// } 
// @4 per 1 year
rule couple_has_child {
    pick $x: type = Person, alive = true, partner != null
    pick $y: type = Person, alive = true, partner = $x, id != $x
    var $fname = '{random name}'
    create $c: Person, '{$fname} {$x.first_name}son'
        set $c.first_name = $fname
        set $c.alive = true
        set $c.age = Age.Child
        set $c.birthdate = #Time.year
    create $l1: Link
        set $l1.parent = $x
        set $l1.child = $c
    create $l2: Link
        set $l2.parent = $y
        set $l2.child = $c
    
    record '{$x} {$x.name} and {$y} {$y.name} have a child, {$c} {$c.name}, in the year {#Time.year}'
}
// @1 per 2 year
rule make_item {
    pick $p: type=Person, alive = true, job=Job.Smith, age > Age.Child
    create $i: Item, '{random item} of {random name}'
    set $i.item_type = ItemType.Forged
    set $i.owner = $p
    record '{$p} {$p.name} crafts the {$i} {$i.name}'
}
// @1 per 2 year
rule paint_item {
    pick $p: type=Person, alive = true, job=Job.Painter, age > Age.Child
    pick $t: type=Person, alive = true, id != $p
    create $i: Item, 'Portrait of {$t.name}'
    set $i.item_type = ItemType.Painted
    set $i.owner = $p
    record '{$p} {$p.name} paints the {$i} {$i.name}'
}
// @1 per 8 year
rule item_lost {
    pick $i: type=Item, owner != null
    pick $p: id = owner, alive
    var $prev = $i.owner
    set $i.owner = null 
    record '{$prev.name} lost the {$i.name}'
}
// @1 per 20 year
rule item_found {
    pick $p: type=Person, alive = true
    pick $i: type=Item, owner = null
    set $i.owner = $p
    record '{$p.name} obtains the {$i.name}'
}
// @1 per 10 year
rule item_sold {
    pick $i: type=Item, owner != null
    pick $p: type=Person, id != $i.owner
    set $i.owner = $p
    record '{$p.name} acquires the {$i.name}'
}
// @1 per 20 year
rule create_faction {
    pick $p: type=Person, alive, faction = null, age > Age.Child
    create $f: Faction, 'Faction of {random name}'
    set $f.owner = $p
    set $p.faction = $f
    record '{$p.name} creates the {$f.name}'
}
// @1 per 2 year
rule char_joins_faction {
pick $p: type=Person, alive, faction = null, age > Age.Child
    pick $f: type=Faction
    set $p.faction = $f
    record '{$p.name} joins the {$f.name}'
}