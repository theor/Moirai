entity person {}
entity item {}
entity faction {}
entity link {}

enum Job = Smith, Farmer, Noble

prop alive = bool
prop owner = ref
prop partner = ref
prop faction = ref
prop parent = ref
prop child = ref
prop job = Job

event inherit {
    when $p: type = "person", alive = false
    each $i: type = "item", owner = $p {
        pick $l: type = "link", $l.parent = $p 
        pick $c: type = "person", alive = true, id = $l.child
            set $i.owner = $c
            format "{$c.name} inherits the {$i.name} from {$p.name}"
    }
}

rule char_born {
    create $0: "person"
    set $0.alive = true
    format "{$0.name} is born"
}
rule char_dies {
    pick $p: type = "person", alive = true
    set $p.alive = false 
    format "{$p.name} dies"
}
rule _parent_dies {
    each $l: type = "link" {
        pick $p: id = $l.parent, alive = true
        pick $c: id = $l.child
        set $p.alive = false 
        format "{$p.name}, parent of {$c.name}, dies"

    }
}
rule wedding {
    pick $x: type = "person", alive = true, partner = null
    pick $y: type = "person", alive = true, partner = null, id != $x
    set $x.partner = $y
    set $y.partner = $x
    format "{$x.name} and {$y.name} get married"
}
rule divorce {
    pick $x: type = "person", alive = true, partner != null
    pick $y: type = "person", alive = true, partner != null, id != $x
    set $x.partner = null
    set $y.partner = null
    format "{$x.name} and {$y.name} separate"
}
rule couple_has_child {
    pick $x: type = "person", alive = true, partner != null
    pick $y: type = "person", alive = true, partner = $x, id != $x
    create $c: "person"
        set $c.alive = true
    create $l1: "link"
        set $l1.parent = $x
        set $l1.child = $c
    create $l2: "link"
    
    format "{$x.name} and {$y.name} have a child, {$c.name}"
}
rule make_item {
    pick $p: type="person", alive = true
    create $i: "item"
    set $i.owner = $p
    format "{$p.name} creates the {$i.name}"
}
rule item_lost {
    pick $i: type="item", owner != null
    set $i.owner = null
    format "The {$i.name} is lost"
}
rule item_found {
    pick $p: type="person", alive = true
    pick $i: type="item", owner = null
    set $i.owner = $p
    format "{$p.name} obtains the {$i.name}"
}
rule item_sold {
    pick $i: type="item", owner != null
    pick $p: type="person", id != $i.owner
    set $i.owner = $p
    format "{$p.name} acquires the {$i.name}"
}
rule create_faction {
    pick $p: type="person", alive=true, faction = null
    create $f: "faction"
    set $f.owner = $p
    set $p.faction = $f
    format "{$p.name} creates the {$f.name}"
}
rule char_joins_faction {
pick $p: type="person", faction = null
    pick $f: type="faction"
    set $p.faction = $f
    format "{$p.name} joins the {$f.name}"
}