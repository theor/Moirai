@1 per 10 year
rule country_war_peace war country {
    pick $x: type = Country, war_with != null
    var $y: $x.war_with
    set $x.war_with = null
    set $y.war_with = null
    record '{$x.name} and {$y.name} sign a peace treaty, ending the war'
    set $x.prosperity =  $x.prosperity + 1
    set $y.prosperity =  $y.prosperity + 1
}
@1 per 10 year
rule country_war_win war country {
    pick $x: type = Country, war_with != null
    var $y: $x.war_with
    set $x.war_with = null
    set $y.war_with = null
    record '{$x.name} wins the war against {$y.name}'

    set $x.prosperity =  $x.prosperity + 3
    set $y.prosperity =  $y.prosperity - 1
}
@2 per 1 year
rule couple_has_child {
    pick $x: type = Person, alive = true, age < Age.Old, partner != null, #Time.year - last_child > 4 
    var $y: $x.partner
    if $y.alive {
        set $x.last_child = #Time.year
        set $y.last_child = #Time.year
        
        var $fname: '{random Name}'
        create $c: Person, '{$fname} {$x.first_name}son'
            set $c.alive = true
            set $c.first_name = $fname
            set $c.birthplace = $x.place
            set $c.god = $x.god
            set $c.parent1 = $x
            set $c.parent2 = $y
        
        record '{$x.name} and {$y.name} have a child, {$c.name}'
    }
}
@1 per 2 year
rule make_item items {
    pick $p: type=Person, alive = true, job=Job.Smith, age > Age.Child
    create $i: Item, '{random ItemType} of {random Name}'
    set $i.item_type = ItemSource.Forged
    set $i.owner = $p
    record '{$p.name} crafts the {$i.name}'
}
@1 per 2 year
rule paint_item items {
    pick $p: type=Person, alive = true, job=Job.Painter, age > Age.Child
    pick $t: type=Person, alive = true, id != $p
    create $i: Item, 'Portrait of {$t.name}'
    set $i.item_type = ItemSource.Painted
    set $i.owner = $p
    record '{$p.name} paints the {$i.name}'
}
@1 per 8 year
rule item_lost items {
    pick $i: type=Item, owner != null
    pick $p: id = $i.owner, alive
    var $prev: $i.owner
    set $i.owner = null 
    record '{$prev.name} lost the {$i.name}'
}
@1 per 20 year
rule item_found items {
    pick $p: type=Person, alive = true
    pick $i: type=Item, owner = null
    set $i.owner = $p
    record '{$p.name} obtains the {$i.name}'
}
@1 per 10 year
rule item_sold items {
    pick $i: type=Item, owner != null
    pick $s: id = $i.owner, type=Person, alive
    pick $p: type=Person, alive, id != $s
    var $prev: $i.owner
    set $i.owner = $p
    record '{$p.name} acquires the {$i.name} from {$prev.name}'
}
@1 per 20 year
rule create_faction {
    pick $p: type=Person, alive, faction = null, age > Age.Child
    create $f: Faction, 'Faction of {random Name}'
    set $f.owner = $p
    set $p.faction = $f
    record '{$p.name} creates the {$f.name}'
}
@1 per 2 year
rule char_joins_faction {
    pick $p: type=Person, alive, faction = null, age > Age.Child
    pick $f: type=Faction
    set $p.faction = $f
    record '{$p.name} joins the {$f.name}'
}
