entity Person
entity Item
entity Faction
entity Country
entity God

enum Job {
    Farmer, Fisher, Hunter,
    Painter, Sculptor, Bard,
    Merchant, Smith,
    Wizard,
    Soldier,
    Monk,
    Prince, King,
}
enum Age { Child, Young, Adult, Old }
enum ItemType { Ring, Sword, Spear, Breastplate, Greatsword, Pendant, }
enum ItemSource { Forged, Painted, Sculpted }
enum Mastery { Novice, Seasoned, Master, Legendary }
enum CountryHealth { Disarray, Recession, Neutral, Emerging, Prosperous }

prop age: Age
prop first_name: string
prop alive: bool
prop birthdate: number
prop prestige: number
prop mastery: Mastery
prop deathdate: number
prop partner: Person
prop war_with: Country
prop god: God
prop faction: Faction
prop birthplace: Country
prop place: Country
prop job: Job
prop item_type: ItemSource
prop prosperity: number
prop health: CountryHealth

prop parent1: Person
prop parent2: Person

prop owner: Person

enum CountryName {
    The_Land_of,
    The_Kingdom_of,
    The_Coast_of,
    The_Province_of
}
enum GodTypes {
    Thunder,
    Fertility,
    The_Hunt,
    The_Sea,
    Wisdom,
    Murder,
    Blood,
    War,
    Death,
}

event create_country country {
    create $c: (Country, '{random(CountryName)} {random(Name)}')
    set prosperity = 5
    set health = CountryHealth.Neutral
    record('{name} is created')
}

event create_god {
    create $g: (God, '{random(Name)}, God of {random(GodTypes)}')
    record('{name} appears')
}
@start
event create_time {
    create $t: (Time, 'time')
    set $t.year = 764
    call(create_country, 10)
    call(create_god, 10)
}

trigger country_prosperity_increase country_events {
    when Country and prosperity >= 10
    set $new.prosperity = 10
}
trigger country_prosperity_decrease country_events {
    when Country and prosperity < 1
    set $new.prosperity = 1
}

@1 per 15 years
event update_country_health country_events {
    each $c: ((type = Country)){
        var $prev: $c.health
        set $c.health = ($c.prosperity + 1) / 2
        var $diff: $prev != $c.health
        match $diff, $c.health  {

            false, CountryHealth.Disarray => random_weighted 100 {
                3 => {
                    record('The governement of {$c.name} disappears in a coup')
                    set $c.health = CountryHealth.Neutral
                    set $c.prosperity = 5
                }
            }
            // true, CountryHealth.Disarray => record('{$c.name} enters an era or disarray')
            true, CountryHealth.Prosperous => record('{$c.name} enters an era of prosperity')
            //  _ => {}
        }
    }
}


trigger inherit items {
    when Person and alive = false and $old.alive
    // record('{$new.name} died')
    set $new.deathdate = #Time.year
    each $i: (type = Item, owner = $new){
        pick $child: (type = Person, parent1 = $new or parent2 = $new)
        // pick $child:( type=Person, id = $l.child, alive)
        set $i.owner = $child
        record('{$child.name} inherits the {$i.name} from {$new.name}')
    }
}

trigger buries_children death {
    when Person and alive = false and $old.alive


    var $parent: $new.parent1
    if $parent and $parent.alive {
        record('++ {$parent.name} buries their child, {$new.name}')
    }
    var $parent2: $new.parent2
    if $parent2 and $parent2.alive {
        record('++ {$parent2.name} buries their child, {$new.name}')
    }
}

trigger born {
    when_created Person
    // record('!!! BORN {$new.birthdate} {#Time.year}')
    // assert_eq $new.birthdate, null
    set $new.alive = true
    set $new.age = Age.Child
    set $new.birthdate = #Time.year
    set $new.place = $new.birthplace

}

@1 per 2 year
event char_born {
    var $fname: '{random(Name)}'
    create $p: (Person, '{$fname} {random(Name)}')
    pick $loc: (type = Country)
    set $p.alive = true
    set $p.first_name = $fname
    set $p.birthplace = $loc
    record('{$p.name} is born in {$loc.name}')
}


@1 every 1 year
event children_grow {
    each $p: (type = Person, alive = true, age = Age.Child, (birthdate + 20) <= #Time.year){
        set $p.age = Age.Young
        random_weighted 100 {
            5 => set $p.job = Job.Smith
            10 => set $p.job = Job.Merchant
            10 => set $p.job = Job.Monk
            25 => set $p.job = Job.Soldier

            5 => set $p.job = Job.Painter
            5 => set $p.job = Job.Sculptor

            5 => set $p.job = Job.Bard
            5 => set $p.job = Job.Wizard

            10 => set $p.job = Job.Hunter
            10 => set $p.job = Job.Fisher
            _ => set $p.job = Job.Farmer
        }
        set $p.mastery = Mastery.Novice

        record('{$p.name} becomes a {$p.job}')
    }
}

@1 every 1 year
event youngs_grow {
    each $p: (type = Person, alive = true, age = Age.Young, (birthdate + 40) <= #Time.year){
        set $p.age = Age.Adult
    //    record('{$p.name} grew up as a {$p.age}')
    }
}

@1 every 1 year
event adults_grow death {
    each $p: (type = Person, alive = true, age = Age.Adult, (birthdate + 60) <= #Time.year){
        set $p.age = Age.Old
        if random(100) < 10 {
            set $p.alive = false
            random_weighted 50 {
                40 => record('{$p.name} dies of sickness at {#Time.year - $p.birthdate} in {#Time.year}')
                _ => record('{$p.name} dies in an accident at {#Time.year - $p.birthdate} in {#Time.year}')
            }
        } else {
            record('{$p.name} grew old')
        }
    }
}

@1 every 1 year
event olds_dies death {
    each $p: (type = Person, alive = true, age = Age.Old, (birthdate + 80) <= #Time.year){
        if random(100) < 20 {
            set $p.alive = false
            random_weighted 100 {
                40 => record('{$p.name} dies of old age at {#Time.year - $p.birthdate} in {#Time.year}')
                40 => record('{$p.name} dies of sickness at {#Time.year - $p.birthdate} in {#Time.year}')
                _ => record('{$p.name} dies in an accident at {#Time.year - $p.birthdate} in {#Time.year}')
            }

        }
    }
}

