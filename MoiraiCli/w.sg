entity Person {}
entity Item {}
entity Faction {}
entity Link {}
entity Country {}
entity God {}

tag #death

enum Job { Smith, Farmer, Painter, Sculptor, Writer, Wizard, Soldier }
enum Age { Child, Young, Adult, Old }
enum ItemType { Forged, Painted, Sculpted }

prop age: Age
prop first_name: string
prop alive: bool
prop birthdate: number
prop deathdate: number
prop children_count: number
prop partner: ref
prop war_with: ref
prop god: ref
prop faction: ref
prop birthplace: ref
prop place: ref
prop job: Job
prop item_type: ItemType

prop parent: ref
prop child: ref

prop owner: ref
 
enum CountryName {
    The_Land_of,
    The_Kingdom_of,
    The_Coast_of,
    The_Province_of
}
enum GodTypes {
    Thunder,
    Fertility,
    The_Hunt,
    The_Sea,
    Wisdom,
    Murder,
    Blood,
    War,
    Death,
}

rule create_country  {
    create Country, '{random CountryName} {random name}'
    record "The {name} is created"
}

rule create_god  {
    create God, '{random name}, God of {random GodTypes}'
    record "{name} appears"
}
@start
rule create_time {
    create Time, 'time'
    set year = 764
    call create_country, 10
    call create_god, 10
}

event inherit death items {
    when #death
    when $p: type = Person, alive = false
    set $p.deathdate = #Time.year
    each $i: type = Item, owner = $p {
        pick $l: type = Link, $l.parent = $p
        pick $child: type=Person, id = $l.child, alive
        set $i.owner = $l.child
        var $c = $l.child
        record '{$c.name} inherits the {$i.name} from {$p.name}'
    }
}

event buries_children death {
    when #death
    when $p: type = Person, alive = false
    
    each $l: type = Link, $l.child = $p {
        pick $parent: type=Person, alive, id = $l.parent
        record '++ {$parent.name} buries their child, {$p.name}'
    }
}

@1 per 2 year
rule char_born {
    var $fname = '{random name}'
    pick $loc: type = Country
    create $p: Person, '{$fname} {random name}'
    set $p.first_name = $fname
    set $p.alive = true
    set $p.age = Age.Child
    set $p.birthdate = #Time.year
    set $p.birthplace = $loc
    set $p.place = $loc
    record '{$p.name} is born in {$loc.name}'
}
rule char_dies {
    pick $p: type = Person, alive = true
    set $p.alive = false 
    record '{$p.name} dies'
}

@1 every 1 year
rule children_grow {
    each $p: type=Person, alive = true, age = Age.Child, (birthdate + 20) <= #Time.year{
        set $p.age = Age.Young
        set $p.job = random Job
        record '{$p.name} becomes a {$p.job}'
    }
}

@1 every 1 year
rule youngs_grow {
    each $p: type=Person, alive = true, age = Age.Young, (birthdate + 40) <= #Time.year{
        set $p.age = Age.Adult
       record '{$p.name} grew up as a {$p.age}'
    }
}

@1 every 1 year
rule adults_grow {
    each $p: type=Person, alive = true, age = Age.Adult, (birthdate + 60) <= #Time.year{
        set $p.age = Age.Old
        record '{$p.name} grew old'
    }   
}

@1 every 1 year
rule olds_dies {
    each $p: type=Person, alive = true, age = Age.Old, (birthdate + 80) <= #Time.year{
        set $p.alive = false
        record '{$p.name} dies of old age at {#Time.year - $p.birthdate} in {#Time.year}'
    }
}

rule _parent_dies {
    each $l: type = Link {
        pick $p: id = $l.parent, alive = true
        pick $c: id = $l.child
        set $p.alive = false 
        record '{$p.name}, parent of {$c.name}, dies'

    }
}
@1 per 1 years
rule char_joins_faith {
    pick $x: type = Person, alive, god = null
    pick $g: type = God
    set $x.god = $g
    record '{$x.name} takes the faith of {$g.name}'
}
 @1 per 2 years
rule wedding {
    pick $x: type = Person, alive = true, partner = null, age > Age.Child
    pick $y: type = Person, alive = true, partner = null, age > Age.Child, id != $x, place = $x.place
    set $x.partner = $y
    set $y.partner = $x
    // create $i: Item, "Wedding ring of {$x.name}"
    // set $i.owner = $x
    // create $j: Item, "Wedding ring of {$y.name}"
    // set $j.owner = $y
    record '{$x.name} and {$y.name} get married'
}
 @1 per 15 year
rule divorce {
    pick $x: type = Person, alive = true, partner != null
    pick $y: type = Person, alive = true, partner != null, id != $x
    set $x.partner = null
    set $y.partner = null
    record '{$x.name} and {$y.name} separate'
} 
@1 per 15 year
rule murder {
    pick $x: type = Person, alive = true, age > Age.Child
    pick $y: type = Person, alive = true, id != $x
    set $y.alive = false
    record '{$x} {$x.name} murders {$y} {$y.name}'
} 
@1 per 4 year
rule char_migrates {
    pick $p: type = Person, alive, partner = null
    pick $c: type = Country, id != $p.place
    set $p.place = $c
    record '{$p.name} moves to {$c.name}'
}
@1 per 4 year
rule country_war_start war {
    pick $x: type = Country, war_with = null
    pick $y: type = Country, id != $x, war_with = null
    set $x.war_with = $y
    set $y.war_with = $x
    record '{$x.name} and {$y.name} start a war'
}
@1 per 1 year
rule soldier_war_distinction war {
    each $c: type = Country, war_with != null {
        pick $s: type = Person, alive, job = Job.Soldier, place = $c
        var $o = $c.war_with
        record '{$s.name}, a soldier from {$c.name}, shines during the war with {$o.name}'

    }
}
@1 per 1 year
rule soldier_war_death war {
    each $c: type = Country, war_with != null {
        pick $s: type = Person, alive, job = Job.Soldier, place = $c
        var $o = $c.war_with
        set $s.alive = false
        record '{$s.name}, a soldier from {$c.name}, dies during the war with {$o.name}'

    }
}
@1 per 10 year
rule country_war_peace war {
    pick $x: type = Country, war_with != null
    var $y = $x.war_with
    set $x.war_with = null
    set $y.war_with = null
    record '{$x.name} and {$y.name} sign a peace treaty, ending the war'
}
@1 per 10 year
rule country_war_win war {
    pick $x: type = Country, war_with != null
    var $y = $x.war_with
    set $x.war_with = null
    set $y.war_with = null
    record '{$x.name} wins the war against {$y.name}'
}
@4 per 1 year
rule couple_has_child {
    pick $x: type = Person, alive = true, partner != null, children_count < 4
    pick $y: id = $x.partner, alive
    set $x.children_count = $x.children_count + 1
    set $y.children_count = $y.children_count + 1
    
    var $fname = '{random name}'
    create $c: Person, '{$fname} {$x.first_name}son'
        set $c.first_name = $fname
        set $c.alive = true
        set $c.age = Age.Child
        set $c.birthdate = #Time.year
        set $c.place = $x.place
        set $c.birthplace = $x.place
        set $c.god = $x.god
    create $l1: Link
        set $l1.parent = $x
        set $l1.child = $c
    create $l2: Link
        set $l2.parent = $y
        set $l2.child = $c
    
    record '{$x.name} and {$y.name} have a child, {$c.name}'
}
@1 per 2 year
rule make_item items {
    pick $p: type=Person, alive = true, job=Job.Smith, age > Age.Child
    create $i: Item, '{random item} of {random name}'
    set $i.item_type = ItemType.Forged
    set $i.owner = $p
    record '{$p.name} crafts the {$i.name}'
}
@1 per 2 year
rule paint_item items {
    pick $p: type=Person, alive = true, job=Job.Painter, age > Age.Child
    pick $t: type=Person, alive = true, id != $p
    create $i: Item, 'Portrait of {$t.name}'
    set $i.item_type = ItemType.Painted
    set $i.owner = $p
    record '{$p.name} paints the {$i.name}'
}
@1 per 8 year
rule item_lost items {
    pick $i: type=Item, owner != null
    pick $p: id = $i.owner, alive
    var $prev = $i.owner
    set $i.owner = null 
    record '{$prev.name} lost the {$i.name}'
}
@1 per 20 year
rule item_found items {
    pick $p: type=Person, alive = true
    pick $i: type=Item, owner = null
    set $i.owner = $p
    record '{$p.name} obtains the {$i.name}'
}
@1 per 10 year
rule item_sold items {
    pick $i: type=Item, owner != null
    pick $s: id = $i.owner, type=Person, alive
    pick $p: type=Person, alive, id != $s
    var $prev = $i.owner
    set $i.owner = $p
    record '{$p.name} acquires the {$i.name} from {$prev.name}'
}
@1 per 20 year
rule create_faction {
    pick $p: type=Person, alive, faction = null, age > Age.Child
    create $f: Faction, 'Faction of {random name}'
    set $f.owner = $p
    set $p.faction = $f
    record '{$p.name} creates the {$f.name}'
}
@1 per 2 year
rule char_joins_faction {
pick $p: type=Person, alive, faction = null, age > Age.Child
    pick $f: type=Faction
    set $p.faction = $f
    record '{$p.name} joins the {$f.name}'
}
