entity Object {
    prop system: System
    prop dead: bool
    prop kind: Kind
    prop distance_to_sun: number
}
entity System {
}
entity Person {
    prop birthplace: Object
    prop location: Object
    prop birthyear: number
    prop age: Age
    prop alive: bool
}
enum Kind { Asteroid, Star, Planet, Satelite, Station }
enum Age { Child, Young, Adult, Old }
function age_years($self: Person): number {
    (#Time.year - $0.birthyear)
}

function age_years_str($self: Person): string {
'{age_years($0)} years old'
}

function available($self: Person): bool {
    ($0.alive and (($0.age = Age.Young) or ($0.age = Age.Adult)))
}

event create_station {
    create Object $0: ('{random (Name)} Station')
    set $0.kind = Kind.Station
    pick System $1: ()
    set $0.system = $1
    record ('{$0.name} created')
}
@start
event create_time {
    create Time $0: ('time')
    set #Time.year = 42
}
@start
event create_solar_system {
    create System $0: ('Solar System')
    create Object $1: ('Sun')
    set $1.kind = Kind.Star
    set $1.system = $0
    create Object $2: ('Mercury')
    set $2.kind = Kind.Planet
    set $2.distance_to_sun = 57
    set $2.system = $0
    create Object $3: ('Venus')
    set $3.kind = Kind.Planet
    set $3.distance_to_sun = 108
    set $3.system = $0
    create Object $4: ('Earth')
    set $4.kind = Kind.Planet
    set $4.distance_to_sun = 149
    set $4.system = $0
    create Object $5: ('Mars')
    set $5.kind = Kind.Planet
    set $5.distance_to_sun = 227
    set $5.system = $0
    create Object $6: ('Jupiter')
    set $6.kind = Kind.Planet
    set $6.distance_to_sun = 778
    set $6.system = $0
    create Object $7: ('Saturn')
    set $7.kind = Kind.Planet
    set $7.distance_to_sun = 1433
    set $7.system = $0
    create Object $8: ('Uranus')
    set $8.kind = Kind.Planet
    set $8.distance_to_sun = 2872
    set $8.system = $0
    create Object $9: ('Neptune')
    set $9.kind = Kind.Planet
    set $9.distance_to_sun = 4495
    set $9.system = $0
    create Object $10: ('Moon')
    set $10.kind = Kind.Satelite
    set $10.system = $0
    record ('{$0.name} created')
    call (create_station, 10)
}
@frequency(1, Frequency.PerXYear, 10)
event born {
    create Person $0: ('{random (Name)}')
}
@frequency(1, Frequency.EveryXYear, 1)
event grow {
    each Person $0: ($0.alive,     ($0.age = Age.Old)) {
        if (random (0, 120) < (#Time.year - $0.birthyear)) {
            set $0.alive = false
            record ('{$0.name} dies of old age at {age_years_str($0)}')
        }

     }

    each Person $0: ($0.alive,     ($0.age != Age.Old),         ((#Time.year - $0.birthyear) > 0),             (((#Time.year - $0.birthyear) % 20) = 0)) {
        set $0.age = ($0.age + 1)
        record ('{$0.name} is now {$0.age}')
     }

}
@frequency(1, Frequency.PerXYear, 5)
event expedition {
    pick Person $0: (available($0))
    pick Object $1: ((($1.kind = Kind.Station) and not ($1.dead)))
    random_weighted 100 {
        40 => {
            record ('{$0.name}\'s expedition  at {$1.name} success')
        }
        30 => {
            set $0.alive = false
            record ('{$0.name} dies at {$1.name}')
        }
        _ => {
            record ('{$0.name} is injured at {$1.name}')
        }
    }

}
trigger when_born {
  when_created Person
    set $0.age = Age.Child
    set $0.birthyear = #Time.year
    set $0.alive = true
    pick Object $1: ((($1.kind = Kind.Planet) or ($1.kind = Kind.Satelite)))
    set $0.birthplace = $1
    set $0.location = $1
    if pick Person $2: (($2.alive and ($2.age = Age.Adult))) {
        record ('{$0.name}  was born on {$1.name} from {$2.name}')
    } else {
        record ('{$0.name}  was born on {$1.name}')
    }

}
