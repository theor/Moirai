553:1 LineBreak '\n'
554:1 Comment '// All aging is now scheduled per-person at birth (see the `born` trigger above): the Child→Young→Adult→Old'
554:108 LineBreak '\n'
555:1 Comment '// transitions, and natural death — drawn once when a person turns Old, instead of the old children_grow /'
555:107 LineBreak '\n'
556:1 Comment '// youngs_grow / adults_grow / olds_dies events that re-scanned the whole population every year.'
556:97 LineBreak '\n'
557:1 LineBreak '\n'
558:1 Comment '// event _parent_dies {'
558:24 LineBreak '\n'
559:1 Comment '//     each $l:( type = Link ){'
559:32 LineBreak '\n'
560:1 Comment '//         pick $p:( id = $l.parent, alive = true)'
560:51 LineBreak '\n'
561:1 Comment '//         pick $c:( id = $l.child)'
561:36 LineBreak '\n'
562:1 Comment '//         set $p.alive = false'
562:32 LineBreak '\n'
563:1 Comment '//         record('{$p.name}, parent of {$c.name}, dies')'
563:58 LineBreak '\n'
564:1 LineBreak '\n'
565:1 Comment '//     }'
565:9 LineBreak '\n'
566:1 Comment '// }'
