<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <SpaRoot>ClientAppSvelte\</SpaRoot>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CommandLineParser" Version="2.9.1" />
        <PackageReference Include="JetBrains.Annotations" Version="2024.2.0" />
        <PackageReference Include="Microsoft.AspNetCore.SpaServices.Extensions" Version="10.0.10" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Moirai.Api\Moirai.Api.csproj" />
      <ProjectReference Include="..\Moirai.Parser\Moirai.Parser.csproj" />
      <ProjectReference Include="..\Moirai\Moirai.csproj" />
      <ProjectReference Include="..\Moirai.DebugAdapter\Moirai.DebugAdapter.csproj" />
    </ItemGroup>
    <!-- The release zip starts with one click: a story to load and a launcher for each platform. -->
    <ItemGroup>
        <Content Update="ClientApp\**;ClientAppSvelte\**;Hubs\**" CopyToPublishDirectory="Never" />
        <None Include="..\MoiraiCli\w.sg" Link="w.sg" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
        <None Update="release\run.cmd;release\run.sh" Link="%(Filename)%(Extension)" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <Target Name="PublishRunWebpack" AfterTargets="ComputeFilesToPublish">
        <!-- As part of publishing, ensure the JS resources are freshly built in production mode -->
        <Exec WorkingDirectory="$(SpaRoot)" Command="yarn install" />
        <Exec WorkingDirectory="$(SpaRoot)" Command="yarn build" />

        <!-- Include the newly-built files in the publish output -->
        <ItemGroup>
            <!-- adapter-static writes build/. A staged WebAssembly engine (yarn wasm:build) lands there too,
                 but it is the Pages site's, not the server's: leave it out. -->
            <DistFiles Include="$(SpaRoot)build\**" Exclude="$(SpaRoot)build\_framework\**;$(SpaRoot)build\w.sg" />
            <ResolvedFileToPublish Include="@(DistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
                <RelativePath>wwwroot\%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
                <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>
</Project>
