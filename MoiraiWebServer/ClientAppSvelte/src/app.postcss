@font-face {
  /* Reference name */
  font-family: 'Roboto';
  /* For multiple files use commas, ex: url(), url(), ... */
  src: url('/fonts/Roboto-Regular.ttf');
}

@font-face {
  /* Reference name */
  font-family: 'Pattaya';
  /* For multiple files use commas, ex: url(), url(), ... */
  src: url('/fonts/Pattaya-Regular.ttf');
}

@tailwind base;
@tailwind components;
@tailwind utilities;
@tailwind variants;

:root [data-theme='skeleton'] {
  --zzzzzzzzz: 40px;
  --theme-font-family-base: 'Roboto', sans-serif;
  --theme-font-family-heading: 'Roboto', sans-serif;
  --theme-font-family-logo: 'Pattaya', serif;
}
html,
body {
  @apply h-full overflow-hidden;
  height: 100vh;
}
