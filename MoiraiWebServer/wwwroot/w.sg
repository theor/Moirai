@frequency(1, PerXYear, 10)
event country_war_peace war country {
    pick Country $x: (war_with != null)
    var $y: $x.war_with
    set $x.war_with = null
    set $y.war_with = null
    record('{$x.name} and {$y.name} sign a peace treaty, ending the war')
    set $x.prosperity = $x.prosperity + 10%
    set $y.prosperity = $y.prosperity + 10%
}
@frequency(1, PerXYear, 10)
event country_war_win war country {
    pick Country $x: (war_with != null)
    var $y: $x.war_with
    set $x.war_with = null
    set $y.war_with = null
    record('{$x.name} wins the war against {$y.name}')

    set $x.prosperity = $x.prosperity + 30%
    set $y.prosperity = $y.prosperity - 10%
}
@frequency(1, PerXYear, 20)
event country_natural_disaster country {
    pick Country $c
    var $d: random_weighted 100 {
        20 => 'A flood'
        20 => 'A volcano'
        20 => 'A famine'
        _ => 'An earthquake'
    }
    set $c.prosperity = $c.prosperity - 30%
    record('{$d} hits {$c.name}')
}
@frequency(2, PerXYear, 1)
event couple_has_child {
    pick Person $x: (alive = true, age < Age.Old, partner != null, since_last($x) > 4)
    var $y: $x.partner
    if $y.alive {
        mark($x)
        mark($y)

        var $fname: '{random(Name)}'
        create Person $c: ('{$fname} {$x.first_name}son')
        set $c.alive = true
        set $c.first_name = $fname
        set $c.birthplace = $x.place
        set $c.god = $x.god
        set $c.parent1 = $x
        set $c.parent2 = $y

        record('{$x.name} and {$y.name} have a child, {$c.name}')
    }
}
@frequency(1, PerXYear, 10)
event parent_child_quarrel {
    pick Person $x: (alive = true and age > Age.Child and (parent1 != null or parent2 != null)) 
    pick Person $p: (alive and (id = $x.parent1 or id = $x.parent2))
    
    set $p.prosperity = $p.prosperity - 10%
    set $x.prosperity = $p.prosperity - 10%
    record('{$x.name} and {$p.name} got into a quarrel')
}
@frequency(1, PerXYear, 8)
event item_forged items {
    pick Person $p: (alive = true, job = Job.Smith, age > Age.Child)
    set $p.prestige = $p.prestige + 10%
    create Item $i: ('{random(ItemType)} of {random(Name)}')
    set $i.item_type = ItemSource.Forged
    set $i.maker = $p
    set $i.creation_date = #Time.year
    set $i.owner = $p
    record('{$p.name} crafts the {$i.name}')
}
@frequency(1, PerXYear, 8)
event item_painted items {
    pick Person $p: (alive = true, job = Job.Painter, age > Age.Child)
    set $p.prestige = $p.prestige + 10%
    pick Person $t: (alive = true, id != $p)
    create Item $i: ('Portrait of {$t.name}')
    set $i.maker = $p
    set $i.item_type = ItemSource.Painted
    set $i.creation_date = #Time.year
    if (random 10 > 5){
        set $i.owner = $p
        record('{$p.name} depicts {$t.name} in the {$i.name}')
    } else {    
        set $i.owner = $t
        record('{$t.name} have their {link($i, 'portrait')} painted by {$p.name}')
    }
}
@frequency(1, PerXYear, 8)
event item_lost items {
    pick Item $i: (owner != null)
    pick Person $p: (id = $i.owner, alive)
    var $prev: $i.owner
    set $i.owner = null
    record('{$prev.name} lost the {$i.name}')
}
@frequency(1, PerXYear, 20)
event item_found items {
    pick Person $p: (alive = true)
    pick Item $i: (owner = null)
    set $i.owner = $p
    record('{$p.name} finds the {$i.name}')
}
@frequency(1, PerXYear, 10)
event item_sold items {
    pick Item $i: (owner != null)
    pick Person $s: (id = $i.owner, alive)
    pick Person $p: (alive, id != $s)
    var $prev: $i.owner
    set $i.owner = $p
    record('{$p.name} acquires the {$i.name} from {$prev.name}')
}
@frequency(1, PerXYear, 20)
event create_faction {
    pick Person $p: (alive, faction = null, age > Age.Child)
    create Faction $f: ('Faction of {random(Name)}')
    set $f.founder = $p
    set $p.faction = $f
    record('{$p.name} creates the {$f.name}')
}
@frequency(1, PerXYear, 2)
event char_joins_faction {
    pick Person $p: (alive, faction = null, age > Age.Child)
    pick Faction $f: ()
    set $p.faction = $f
    record('{$p.name} joins the {$f.name}')
}
