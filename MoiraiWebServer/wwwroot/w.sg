@frequency(1, PerXYear, 5)
event char_prestige_update items {
    each Person $p: (alive, prestige > 0){
        match $p.job {
            Job.Painter => {
                if $p.prestige > 50% and $p.mastery < Mastery.Master {
                    record('{$p.name} is now a master painter')
                    set $p.mastery = Mastery.Master
                    set $p.prosperity = $p.prosperity + 20%
                }
            }
            Job.Smith => {
                if $p.prestige > 50% and $p.mastery < Mastery.Master {
                    record('{$p.name} is now a master smith')
                    set $p.mastery = Mastery.Master
                    set $p.prosperity = $p.prosperity + 20%
                }
            }
        }
    }
    each Person $p: (prosperity < 10%) {
        random_weighted 100 {
            10 => {
                record('{$p.name} commit suicide')
                set $p.alive = false
            }
        }
    }
}
@frequency(1, PerXYear, 1)
event char_joins_faith {
    pick Person $x: (alive, god = null)
    pick God $g
    set $x.god = $g
    record('{$x.name} takes the faith of {$g.name}')
}
@frequency(1, PerXYear, 2)
event wedding {
    pick Person $x: (alive = true and partner = null and age > Age.Child and age < Age.Old)
    pick Person $y: (alive = true and partner = null and age > Age.Child and age < Age.Old and id != $x and place = $x.place and parent1 != $x and parent2 != $x and id != $x.parent1 and id != $x.parent2)
    set $x.partner = $y
    set $y.partner = $x
    set $x.prosperity = $x.prosperity + 20%
    set $y.prosperity = $y.prosperity + 20%

    // create $i: ( Item, "Wedding ring of {$x.name}")    // set $i.owner = $x
    // create $j: ( Item, "Wedding ring of {$y.name}")    // set $j.owner = $y
    record('{$x.name} and {$y.name} get married')
}
@frequency(1, PerXYear, 15)
event divorce {
    pick Person $x: (alive = true, partner != null)
    pick Person $y: (alive = true, partner != null, id != $x)
    set $x.partner = null
    set $y.partner = null
    record('{$x.name} and {$y.name} separate')
}
@frequency(1, PerXYear, 15)
event murder {
    pick Person $x: (alive = true, age > Age.Child, prosperity < 20%)
    pick Person $y: (alive = true, id != $x, place = $x.place)
    set $y.alive = false
    set $y.killer = $x
    record('{$x.name} murders {$y} {$y.name}')
}
@frequency(1, PerXYear, 15)
event bandits_attack_town {
    pick Person $x: (alive = true, job = Job.Bandit)
    pick Country $c: ($x.place = $c)
    pick Person $y: (alive = true, id != $x, place = $c)
    set $y.alive = false
    set $y.killer = $x
    set $x.prosperity = $x.prosperity + 30%
    record '{$x.name} bandits pillage a town of {$c.name}' 
    record '{$y.name} die in the pillage of {$c.name}'
}
@frequency(1, PerXYear, 4)
event char_migrates country {
    pick Person $p: (alive, partner = null)
    pick Country $c: (id != $p.place)
    set $p.place = $c
    record('{$p.name} moves to {$c.name}')
}
@frequency(1, PerXYear, 25)
event country_war_start war {
    pick Country $x: (war_with = null)
    pick Country $y: (id != $x, war_with = null)
    set $x.war_with = $y
    set $y.war_with = $x
    record('{$x.name} and {$y.name} start a war')
    set $x.prosperity = $x.prosperity - 10%
    set $y.prosperity = $y.prosperity - 10%
}
@frequency(5, PerXYear, 1)
event soldier_war_distinction war country {
    each Country $c: (war_with != null){
        pick Person $s: (alive, job = Job.Soldier, place = $c)
        var $o: $c.war_with
        random_weighted 100 {
            10 => {
                set $s.prestige = $s.prestige + 10%
                record('{$s.name}, a soldier from {$c.name}, shines during the war with {$o.name}')
            }
            10 => {
                set $s.alive = false

                record('{$s.name}, a soldier from {$c.name}, dies during the war with {$o.name}')
            }
        }

    }
}

