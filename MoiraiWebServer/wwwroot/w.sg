@display Item ('Items made',maker = $self)
@display Person ('Children',parent1 = $self or parent2 = $self)
@display Person ('Parents', $other = $self.parent1 or $other = $self.parent2)
@display Item   ('Items owned',owner = $self)
entity Person {
    prop age: Age
    prop first_name: string
    prop alive: bool
    prop birthdate: number
    prop prestige: percentage
    prop mastery: Mastery
    prop deathdate: number
    prop partner: Person
    prop god: God
    prop faction: Faction
    prop birthplace: Country
    prop place: Country
    prop job: Job
    prop parent1: Person
    prop parent2: Person
    prop killer: Person
    prop prosperity: percentage
}
@display ItemOwnership ('Owners', item = $self, '{$other.owner.name} from {$other.start_year} to {$other.end_year}')
entity Item {
    prop maker: Person
    prop item_type: ItemSource
    prop owner: Person
    prop creation_date: number
}
entity ItemOwnership {
    prop item: Item
    prop owner: Person
    prop start_year: number
    prop end_year: number
}
@display Person ('Members',faction = $self)
entity Faction {
    prop founder: Person

}
@display Person ('Citizens',birthplace = $self)
entity Country {
    prop war_with: Country
    prop health: CountryHealth
    prop prosperity: percentage

}
@display Person ('Believers',god = $self)
entity God {
}

enum Job {
    Farmer, Fisher, Hunter,
    Painter, Sculptor, Bard,
    Merchant, Smith,
    Wizard,
    Soldier,
    Bandit,
    Monk,
    Prince, King,
}
enum Age { Child, Young, Adult, Old }
enum ItemType { Ring, Sword, Spear, Breastplate, Greatsword, Pendant, }
enum ItemSource { Forged, Painted, Sculpted }
enum Mastery { Novice, Seasoned, Master, Legendary }
enum CountryHealth { Disarray, Recession, Neutral, Emerging, Prosperous }




enum CountryName {
    The_Land_of,
    The_Kingdom_of,
    The_Coast_of,
    The_Province_of
}
enum GodTypes {
    Thunder,
    Fertility,
    The_Hunt,
    The_Sea,
    Wisdom,
    Murder,
    Blood,
    War,
    Death,
}

event create_country country {
    create Country $c: '{random(CountryName)} {random(Name)}'
    set prosperity = 50%
    set health = CountryHealth.Neutral
    record('{name} is created')
}

event create_god {
    create God $g: '{random(Name)}, God of {random(GodTypes)}'
    record '{name} appears'
}
@start
event create_time {
    create Time $t: 'time'
    set $t.year = 764
    call(create_country, 10)
    call(create_god, 10)
}

@frequency(1, PerXYear, 15)
event update_country_health country_events {
    each Country $c {
        var $prev: $c.health
        set $c.health = ($c.prosperity / 10 + 1) / 2
        var $diff: $prev != $c.health
        match $diff, $c.health  {

            false, CountryHealth.Disarray => random_weighted 100 {
                3 => {
                    record('The governement of {$c.name} disappears in a coup')
                    set $c.health = CountryHealth.Neutral
                    set $c.prosperity = 50%
                }
            }
            // true, CountryHealth.Disarray => record('{$c.name} enters an era or disarray')
            true, CountryHealth.Prosperous => record('{$c.name} enters an era of prosperity')
            //  _ => {}
        }
    }
}

trigger item_created items {
    when_created Item
    create ItemOwnership $on
    set $on.owner = $new.owner
    set $on.item = $new
    set $on.start_year = #Time.year
}
trigger item_change_owner items {
    when Item and owner != $old.owner

    create ItemOwnership $on
    set $on.owner = $new.owner
    set $on.item = $new
    set $on.start_year = #Time.year

    pick ItemOwnership $o: (item = $old and end_year = 0)
    set $o.end_year = #Time.year
}

trigger inherit items {
    when Person and alive = false and $old.alive
    record('{$new.name} died')
    set $new.deathdate = #Time.year
    each Person $child: (parent1 = $new or parent2 = $new, alive) {
        record('{$child.name} lose their parent, {$new.name}')
        if $new.killer {
            var $k: $new.killer
            record '{$child.name} starts a vendetta with {$k.name}'
        }
    }
    each Item $i: (owner = $new){
        if(pick Person $child: (alive, parent1 = $new or parent2 = $new)) {
        // pick $child:( type=Person, id = $l.child, alive)
            set $i.owner = $child
            record('{$child.name} inherits the {$i.name} from {$new.name}')
        } else {
            record('The {$i.name} is lost after the death of {$new.name}')
            set $i.owner = null

        }
    }
}

trigger buries_children death {
    when Person and alive = false and $old.alive


    var $parent: $new.parent1
    if $parent and $parent.alive {
        set $parent.prosperity = $parent.prosperity - 20%
        record('{$parent.name} bury their child, {$new.name}')
    }
    var $parent2: $new.parent2
    if $parent2 and $parent2.alive {
        set $parent2.prosperity = $parent2.prosperity - 20%
        record('{$parent2.name} bury their child, {$new.name}')
    }
}

trigger born {
    when_created Person
    // record('!!! BORN {$new.birthdate} {#Time.year}')
    // assert_eq $new.birthdate, null
    set $new.alive = true
    set $new.prosperity = 50%
    set $new.age = Age.Child
    set $new.birthdate = #Time.year
    set $new.place = $new.birthplace

}

@frequency(1, PerXYear, 2)
event char_born {
    var $fname: '{random(Name)}'
    create Person $p: ('{$fname} {random(Name)}')
    pick Country $loc
    set $p.alive = true
    set $p.first_name = $fname
    set $p.birthplace = $loc
    record('{$p.name} is born in {$loc.name}')
}


@frequency(1, EveryXYear, 1)
event children_grow {
    each Person $p: (alive = true, age = Age.Child, (birthdate + 20) <= #Time.year){
        set $p.age = Age.Young
        random_weighted 100 {
            5 => set $p.job = Job.Smith
            10 => set $p.job = Job.Merchant
            10 => set $p.job = Job.Monk
            25 => set $p.job = Job.Soldier
            10 => set $p.job = Job.Bandit

            5 => set $p.job = Job.Painter
            5 => set $p.job = Job.Sculptor

            5 => set $p.job = Job.Bard
            5 => set $p.job = Job.Wizard

            10 => set $p.job = Job.Hunter
            10 => set $p.job = Job.Fisher
            _ => set $p.job = Job.Farmer
        }
        set $p.mastery = Mastery.Novice

        record('{$p.name} becomes a {$p.job}')
    }
}

@frequency(1, EveryXYear, 1)
event youngs_grow {
    each Person $p: (type = Person, alive = true, age = Age.Young, (birthdate + 40) <= #Time.year){
        set $p.age = Age.Adult
    //    record('{$p.name} grew up as a {$p.age}')
    }
}

@frequency(1, EveryXYear, 1)
event adults_grow death {
    each Person $p: (alive = true, age = Age.Adult, (birthdate + 60) <= #Time.year){
        set $p.age = Age.Old
        if random(100) < 10 {
            set $p.alive = false
            random_weighted 50 {
                40 => record('{$p.name} dies of sickness at {#Time.year - $p.birthdate} in {#Time.year}')
                _ => record('{$p.name} dies in an accident at {#Time.year - $p.birthdate} in {#Time.year}')
            }
        } else {
            record('{$p.name} grew old')
        }
    }
}

@frequency(1, EveryXYear, 1)
event olds_dies death {
    each Person $p: (alive = true, age = Age.Old, (birthdate + 80) <= #Time.year){
        if random(100) < 20 {
            set $p.alive = false
            random_weighted 100 {
                40 => record('{$p.name} dies of old age at {#Time.year - $p.birthdate} in {#Time.year}')
                40 => record('{$p.name} dies of sickness at {#Time.year - $p.birthdate} in {#Time.year}')
                _ => record('{$p.name} dies in an accident at {#Time.year - $p.birthdate} in {#Time.year}')
            }

        }
    }
}

