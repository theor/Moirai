@frequency(1, PerXYear, 2)
event born {
    create Person $p: ('{random(Name)}')
    pick Object $o: (kind = Kind.Planet or kind = Kind.Satelite)
    set $p.birthplace = $o
    set $p.location = $o
    record '{$p.name} was born on {$o.name}'
}
