entity System {
    prop typea: string
}

@start
event create_solar_system {
    create System $s: 'Solar System'
    create System $sys: ()
    // each System $s: () {
    //     set $s.
    // }
}
trigger born {
    when created System $s
    // record('!!! BORN {$s.birthdate} {#Time.year}')
    // assert_eq $s.birthdate, null
    set $s.name = 'asd'
}

trigger test {
    when System $s
    set $s.name = 'qweqe'
}
