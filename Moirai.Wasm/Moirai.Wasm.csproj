<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-browser</TargetFramework>
        <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Moirai.Wasm</RootNamespace>
        <WasmMainJSPath>main.js</WasmMainJSPath>

        <!-- Required by the [JSExport]/[JSImport] source generator, which emits pointer code for the
             marshalling stubs. None of our own code is unsafe. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <!-- Drops the ICU payload, and makes CurrentCulture invariant. The parser calls float.Parse and
             int.Parse without an IFormatProvider, so on a comma-decimal locale a story's numeric literals
             would otherwise misparse. The server sets this for the same reason. -->
        <InvariantGlobalization>true</InvariantGlobalization>

        <!-- Nothing here reflects any more: the wire types are serialized by a source-generated
             context (Moirai.Api/MoiraiJsonContext.cs) and the query page prints the parsed expression
             with the engine's own printer. So the linker can trim our assemblies as well as the
             framework's, and switching reflection off means a type someone forgets to declare fails at
             build time instead of silently in a browser. -->
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>full</TrimMode>
        <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
        <InvariantTimezone>true</InvariantTimezone>

        <!-- The native symbol map only makes a runtime stack trace readable while debugging the runtime
             itself, and it is listed in the boot manifest, so it is fetched on every start. Not emitting
             it is the way to drop it: deleting the file afterwards just turns the fetch into a 404. -->
        <WasmEmitSymbolMap>false</WasmEmitSymbolMap>

    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Moirai.Api\Moirai.Api.csproj" />
    </ItemGroup>

</Project>
