{
	"name": "moirai-lsp",
	"description": "Moirai language server",
	"author": "Microsoft Corporation",
	"license": "MIT",
	"version": "1.0.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/theor/moirai"
	},
	"publisher": "theor",
	"categories": [],
	"keywords": [
		"multi-root ready"
	],
	"engines": {
		"vscode": "^1.75.0"
	},
	"activationEvents": [
		"onLanguage:moirai",
		"onDebug"
	],
	"main": "./client/out/extension",
	"contributes": {
		"languages": [
			{
				"id": "moirai",
				"extensions": [
					".sg",
					".moi"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "moirai",
				"scopeName": "source.moirai",
				"path": "./moirai.tmLanguage.json"
			}
		],
		"breakpoints": [
			{
				"language": "moirai"
			}
		],
		"debuggers": [
			{
				"type": "moirai",
				"label": "Moirai",
				"languages": [
					"moirai"
				],
				"configurationAttributes": {
					"launch": {
						"properties": {
							"program": {
								"type": "string",
								"description": "Path to the .sg story being debugged (for source mapping).",
								"default": "${workspaceFolder}/MoiraiCli/w.sg"
							},
							"host": {
								"type": "string",
								"description": "Host of the Moirai web server's debug adapter.",
								"default": "127.0.0.1"
							},
							"port": {
								"type": "number",
								"description": "Port passed to the web server via --debug-port.",
								"default": 4711
							},
							"years": {
								"type": "number",
								"description": "Number of years to simulate under the debugger.",
								"default": 100
							},
							"stopOnEntry": {
								"type": "boolean",
								"description": "Break on the first executed statement.",
								"default": false
							}
						}
					},
					"attach": {
						"properties": {
							"host": {
								"type": "string",
								"default": "127.0.0.1"
							},
							"port": {
								"type": "number",
								"default": 4711
							}
						}
					}
				},
				"initialConfigurations": [
					{
						"type": "moirai",
						"request": "launch",
						"name": "Moirai: debug story",
						"program": "${workspaceFolder}/MoiraiCli/w.sg",
						"host": "127.0.0.1",
						"port": 4711,
						"years": 100,
						"stopOnEntry": false
					}
				],
				"configurationSnippets": [
					{
						"label": "Moirai: Debug story (launch)",
						"description": "Drive a simulation under the debugger (web server must run with --debug-port).",
						"body": {
							"type": "moirai",
							"request": "launch",
							"name": "Moirai: debug story",
							"program": "^\"\\${workspaceFolder}/MoiraiCli/w.sg\"",
							"host": "127.0.0.1",
							"port": 4711,
							"years": 100
						}
					}
				]
			}
		],
    "commands": [
      {
        "command": "moirai.restart",
        "title": "Restart Moirai Language Server"
      },
      {
        "command": "moirai.servercommand",
        "title": "Moirai server command"
      }
    ],
		"configuration": {
			"type": "object",
			"title": "Example configuration",
			"properties": {
				"moirai.maxNumberOfProblems": {
					"scope": "resource",
					"type": "number",
					"default": 100,
					"description": "Controls the maximum number of problems produced by the server."
				},
				"moirai.trace.server": {
					"scope": "window",
					"type": "string",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"default": "verbose",
					"description": "Traces the communication between VS Code and the language server."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "yarn run compile",
		"compile": "tsc -b",
		"watch": "yarn run tsc -b -w",
		"lint": "eslint ./client/src --ext .ts,.tsx",
		"postinstall": "cd client && npm install && cd ../server && dotnet build && cd .."
	},
	"devDependencies": {
		"@types/mocha": "^9.1.0",
		"@types/node": "^16.18.34",
		"@typescript-eslint/eslint-plugin": "^6.7.0",
		"@typescript-eslint/parser": "^6.7.0",
		"eslint": "^8.35.0",
		"mocha": "^9.2.1",
		"typescript": "^5.2.2"
	}
}
