{
  "$comment": "Moirai (.sg) TextMate grammar, shared by the VS Code extension and the blog's shiki. Token-level on purpose: every token is recognised on its own, as MoiraiTokenizer does, so a fragment of a story (a scrollycoding step, a hover) colours the same as the whole file. Structure belongs to the parser and the language server's semantic tokens, which paint over this in VS Code. The keyword and builtin lists are pinned to the engine by TextMateGrammarDriftTests.",
  "name": "moirai",
  "scopeName": "source.moirai",
  "fileTypes": ["sg", "moi"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#attribute" },
    { "include": "#definition" },
    { "include": "#expression" },
    { "match": "[{}]", "name": "punctuation.section.block.moirai" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "$comment": "The delimiters are scoped apart from the text, as in most grammars: the blog's scrollycoding reads annotations (`// !focus(1:2)`) out of the comment text and removes the delimiters with them.",
          "match": "(///)(.*)$",
          "name": "comment.line.documentation.moirai",
          "captures": { "1": { "name": "punctuation.definition.comment.moirai" } }
        },
        {
          "match": "(//)(.*)$",
          "name": "comment.line.double-slash.moirai",
          "captures": { "1": { "name": "punctuation.definition.comment.moirai" } }
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.moirai",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.begin.moirai" } },
          "endCaptures": { "0": { "name": "punctuation.definition.comment.end.moirai" } }
        }
      ]
    },
    "attribute": {
      "$comment": "@frequency(1, PerXYear, 4), @tag('war'), @parents(parent1, parent2)",
      "match": "(@)([A-Za-z_]\\w*)",
      "captures": {
        "1": { "name": "punctuation.definition.decorator.moirai" },
        "2": { "name": "entity.name.function.decorator.moirai" }
      }
    },
    "definition": {
      "$comment": "The name a definition introduces. Before #expression, whose keyword rule would otherwise take the keyword alone and leave the name to the generic identifier rules.",
      "patterns": [
        {
          "match": "\\b(event|trigger|function)\\s+([a-z_]\\w*)",
          "captures": {
            "1": { "name": "storage.type.moirai" },
            "2": { "name": "entity.name.function.moirai" }
          }
        },
        {
          "match": "\\b(enum)\\s+([A-Z]\\w*)",
          "captures": {
            "1": { "name": "storage.type.moirai" },
            "2": { "name": "entity.name.type.enum.moirai" }
          }
        },
        {
          "match": "\\b(entity|singleton|table)\\s+([A-Z]\\w*)",
          "captures": {
            "1": { "name": "storage.type.moirai" },
            "2": { "name": "entity.name.type.moirai" }
          }
        },
        {
          "match": "\\b(prop)\\s+([a-z_]\\w*)",
          "captures": {
            "1": { "name": "storage.type.moirai" },
            "2": { "name": "variable.other.property.moirai" }
          }
        }
      ]
    },
    "expression": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#string" },
        { "include": "#attribute" },
        {
          "$comment": "The implicit locals: $self in a method or @display, $new/$old in a trigger.",
          "match": "\\$(?:self|new|old)\\b",
          "name": "variable.language.moirai"
        },
        { "match": "\\$[A-Za-z_]\\w*", "name": "variable.other.readwrite.moirai" },
        { "match": "#[A-Za-z_]\\w*", "name": "entity.name.type.singleton.moirai" },
        { "match": "%[a-z][a-z_]*", "name": "variable.other.property.moirai" },
        { "match": "\\b\\d+(?:\\.\\d+)?%?", "name": "constant.numeric.moirai" },
        {
          "$comment": "Job.Smith: an enum member. Before the plain type rule, which would take `Job` alone.",
          "match": "\\b([A-Z][A-Za-z_]*)(\\.)([A-Z][A-Za-z_]*)\\b",
          "captures": {
            "1": { "name": "entity.name.type.enum.moirai" },
            "2": { "name": "punctuation.accessor.moirai" },
            "3": { "name": "variable.other.enummember.moirai" }
          }
        },
        {
          "$comment": "After a dot a word is a property or a method -- $p.count is not the count() builtin.",
          "match": "(\\.)([a-z_]\\w*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.moirai" },
            "2": { "name": "entity.name.function.moirai" }
          }
        },
        {
          "match": "(\\.)([a-z_]\\w*)",
          "captures": {
            "1": { "name": "punctuation.accessor.moirai" },
            "2": { "name": "variable.other.property.moirai" }
          }
        },
        {
          "$comment": "The primitive types (AstVisitor.ParseType), only where a type is written: `prop age: number`, `($p: Person): bool`. Anywhere else the same word is a property.",
          "match": "(:)\\s*(bool|number|float|string|percentage)\\b",
          "captures": {
            "1": { "name": "punctuation.separator.moirai" },
            "2": { "name": "support.type.primitive.moirai" }
          }
        },
        { "include": "#keywords" },
        { "include": "#builtins" },
        { "match": "\\b[a-z_]\\w*(?=\\s*\\()", "name": "entity.name.function.moirai" },
        { "match": "\\b[A-Z]\\w*", "name": "entity.name.type.moirai" },
        {
          "$comment": "A bare lowercase word in a story is a property: `alive` in a pick's predicate, `start_year` before :=.",
          "match": "\\b[a-z_]\\w*",
          "name": "variable.other.property.moirai"
        },
        { "match": ":=|=>|!=|>=|<=|\\?\\?|[=<>+\\-*/%]", "name": "keyword.operator.moirai" },
        { "match": "[,:]", "name": "punctuation.separator.moirai" },
        { "match": "[()\\[\\]]", "name": "punctuation.section.moirai" }
      ]
    },
    "keywords": {
      "$comment": "Exactly MoiraiTokenizer.Keywords, split by role.",
      "patterns": [
        { "match": "\\b(event|trigger|function|entity|singleton|enum|table|prop)\\b", "name": "storage.type.moirai" },
        { "match": "\\b(when_created|when|if|else|match|random_weighted)\\b", "name": "keyword.control.moirai" },
        { "match": "\\b(set|var)\\b", "name": "keyword.other.moirai" },
        { "match": "\\b(and|or)\\b", "name": "keyword.operator.logical.moirai" },
        { "match": "\\b(true|false|null)\\b", "name": "constant.language.moirai" }
      ]
    },
    "builtins": {
      "$comment": "Exactly StoryParser.Functions. Listed rather than recognised by a following `(`, because the statement forms take none: `create Person $p: ...`, `pick Person $x: (...)`.",
      "match": "\\b(create|each|pick|schedule|assert|assert_eq|mark|since_last|related|record|link|random|chance|roll|add|remove|contains|sum|avg|min|max|count|not|floor|round|ceiling|clamp01|debug|repeat)\\b",
      "name": "support.function.builtin.moirai"
    },
    "string": {
      "begin": "'",
      "end": "'",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.moirai" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.moirai" } },
      "name": "string.quoted.single.moirai",
      "patterns": [
        { "match": "\\\\'", "name": "constant.character.escape.moirai" },
        {
          "$comment": "'{$p.name} of {roll(Name)}': an expression inside the text. The JavaScript template scopes, because every theme already styles those as code rather than string.",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.definition.template-expression.begin.moirai" } },
          "endCaptures": { "0": { "name": "punctuation.definition.template-expression.end.moirai" } },
          "name": "meta.template.expression.moirai",
          "contentName": "meta.embedded.line.moirai",
          "patterns": [{ "include": "#expression" }]
        }
      ]
    }
  }
}
